# ─── Telegram Bot Tokens ─────────────────────────────────────────────────────
# BotFather: t.me/BotFather → /newbot

CASINO_BOT_TOKEN=your_casino_bot_token_here
ADMIN_BOT_TOKEN=your_admin_bot_token_here

# ─── Admin Access ─────────────────────────────────────────────────────────────
# Numeric Telegram ID (t.me/userinfobot). Multiple: 123456,789012
ADMIN_TELEGRAM_IDS=your_telegram_id_here

# ─── Casino Bot Username ──────────────────────────────────────────────────────
# Without @ (e.g. PabloEscobarCasinoBot)
CASINO_BOT_USERNAME=your_casino_bot_username_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Railway: Reference Postgres plugin (do not paste manually if linked)
# Local example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casino

# ─── NOWPayments Gateway (auto deposits + optional auto withdrawals) ─────────
# Dashboard: https://account.nowpayments.io
# 1) Settings → Payments → API keys
# 2) Settings → Payments → IPN (Instant Payment Notifications) → generate secret
# 3) Set PUBLIC_BASE_URL to your Railway HTTPS domain (no trailing slash)
#    IPN callback becomes: {PUBLIC_BASE_URL}/api/nowpayments/ipn
# 4) Optional auto LTC payouts: account email + password (JWT mass payouts)
#    Also whitelist Railway egress IP + payout addresses in NOWPayments dashboard.

NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret_here
PUBLIC_BASE_URL=https://your-railway-app.up.railway.app
# NOWPAYMENTS_IPN_URL=https://your-railway-app.up.railway.app/api/nowpayments/ipn
NOWPAYMENTS_EMAIL=your_nowpayments_account_email
NOWPAYMENTS_PASSWORD=your_nowpayments_account_password
