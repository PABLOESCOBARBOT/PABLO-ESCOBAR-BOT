# ─── Telegram Bot Tokens ─────────────────────────────────────────────────────
# BotFather se banao: t.me/BotFather → /newbot

CASINO_BOT_TOKEN=your_casino_bot_token_here
ADMIN_BOT_TOKEN=your_admin_bot_token_here

# ─── Admin Access ─────────────────────────────────────────────────────────────
# Apna Telegram numeric ID (t.me/userinfobot se pata karo)
# Multiple IDs comma se alag karo: 123456,789012

ADMIN_TELEGRAM_IDS=your_telegram_id_here

# ─── Casino Bot Username ──────────────────────────────────────────────────────
# Casino bot ka username WITHOUT @ (e.g. MyCasinoBot)

CASINO_BOT_USERNAME=your_casino_bot_username_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Replit automatically sets this — DO NOT set manually on Replit
# Local example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casino

# ─── NOWPayments Gateway ─────────────────────────────────────────────────────
# Auto-payment detection + instant user notifications
# Setup: https://account.nowpayments.io → API keys + IPN secret

NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret_here
# Public HTTPS origin used to build IPN URL: {PUBLIC_BASE_URL}/api/nowpayments/ipn
PUBLIC_BASE_URL=https://your-domain.example
